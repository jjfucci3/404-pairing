# Google Sheets
# Setup:
# 1. Go to console.cloud.google.com → create a project → enable Google Sheets API
# 2. Create a service account → generate a JSON key → download it
# 3. Share the Sheet with the service account email (viewer access is enough)
# 4. Paste the entire JSON key as a single line below (no newlines)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
SHEET_ID=1_sm-krnTzxukUaABf5P3ArBLYbiJ1PSmkonLctfegJA

# HTTP basic auth — shared password for team access (Railway/Render deploy)
BASIC_AUTH_USER=404
